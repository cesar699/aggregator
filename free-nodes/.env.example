# Server deployment settings. Copy to `.env` in this same directory and fill in:
#   cp free-nodes/.env.example free-nodes/.env
#
# Domain that serves the subscriptions. With a real domain Caddy issues
# HTTPS certificates automatically (ports 80/443 must reach this server).
DOMAIN=sub.example.com
# For a quick test without a domain, use plain HTTP instead (no TLS):
# DOMAIN=http://1.2.3.4:8080

# UID/GID that will own free-nodes/data on the host (check with `id -u`, `id -g`).
PUID=1000
PGID=1000
